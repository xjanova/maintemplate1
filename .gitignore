# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║                    XCLAUDE FRAMEWORK - Gitignore                          ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# Dependencies
node_modules/
vendor/
venv/
__pycache__/
*.pyc

# Build outputs
dist/
build/
.next/
.nuxt/
out/

# Environment files (NEVER commit these!)
.env
.env.local
.env.*.local
.deploy.config

# IDE
.idea/
.vscode/
*.swp
*.swo
*.sublime-*

# OS
.DS_Store
Thumbs.db
ehthumbs.db

# Logs
*.log
storage/logs/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Deploy artifacts
.deploy-feedback.json
storage/cache/*
!storage/cache/.gitkeep

# SSH keys (NEVER commit these!)
*.pem
*_rsa
*_ed25519
id_*
.ssh/

# Error tracking
storage/cache/.error_count

# Coverage
coverage/
.nyc_output/
htmlcov/

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Uploads (user content)
storage/uploads/*
!storage/uploads/.gitkeep

# PHP specific
.php_cs.cache
.phpunit.result.cache

# Composer
composer.phar
