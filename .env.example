# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║                    XCLAUDE FRAMEWORK - Environment                        ║
# ║                                                                           ║
# ║  คัดลอกไฟล์นี้ไปเป็น .env แล้วแก้ไขค่าต่างๆ                                   ║
# ║  Copy this file to .env and edit the values                              ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ═══════════════════════════════════════════════════════════════════════════
# App Configuration
# ═══════════════════════════════════════════════════════════════════════════

APP_NAME="My Xclaude App"
APP_ENV=development
APP_DEBUG=true
APP_SECRET=your-secret-key-change-this
APP_TIMEZONE=Asia/Bangkok

# ═══════════════════════════════════════════════════════════════════════════
# URLs
# ═══════════════════════════════════════════════════════════════════════════

# URL หลักของเว็บไซต์ (ใช้สำหรับ production)
SITE_URL=https://your-domain.com

# URL สำหรับ staging (ถ้ามี)
STAGING_URL=https://staging.your-domain.com

# ═══════════════════════════════════════════════════════════════════════════
# Server Configuration (สำหรับ auto-deploy)
# ═══════════════════════════════════════════════════════════════════════════

SERVER_HOST=your-server-ip
SERVER_USER=your-ssh-user
DEPLOY_PATH=/var/www/your-app

# ═══════════════════════════════════════════════════════════════════════════
# Database (ถ้าใช้)
# ═══════════════════════════════════════════════════════════════════════════

DB_HOST=localhost
DB_PORT=3306
DB_NAME=xclaude_app
DB_USER=root
DB_PASS=

# ═══════════════════════════════════════════════════════════════════════════
# Line Notification
# ═══════════════════════════════════════════════════════════════════════════

# Line Messaging API Channel Access Token
LINE_CHANNEL_TOKEN=

# Line Notify Token (สำหรับส่งแจ้งเตือนง่ายๆ)
LINE_NOTIFY_TOKEN=

# ═══════════════════════════════════════════════════════════════════════════
# Email (ถ้าใช้)
# ═══════════════════════════════════════════════════════════════════════════

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=noreply@your-domain.com
MAIL_FROM_NAME="Xclaude App"

# ═══════════════════════════════════════════════════════════════════════════
# Security
# ═══════════════════════════════════════════════════════════════════════════

# Allowed hosts (comma separated)
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# Rate limiting (requests per minute)
RATE_LIMIT=60
